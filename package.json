    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "axios": "1.20.0",
    "formik": "2.4.9",
    "framer-motion": "13.2.0",
    "fuse.js": "^7.5.0",
    "iconsax-reactjs": "0.0.8",
    "jwt-decode": "4.0.0",
    "lodash-es": "4.18.1",
    "nitro": "^3.0.260903-beta",
    "react": "19.2.8",
    "react-device-detect": "2.2.3",
    "react-dom": "19.2.8",
    "react-intl": "10.1.26",
    "react-timer-hook": "4.0.6",
    "simplebar-react": "3.3.2",
    "stylis-plugin-rtl": "2.1.1",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "yup": "1.7.1"
  },
  "scripts": {
    "start": "node .output/server/index.mjs",
    "dev": "node scripts/check-i18n.mjs && vite",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build": "tsr generate && node scripts/check-i18n.mjs && tsc && env-cmd -f .env vite build",
    "build-stage": "tsr generate && node scripts/check-i18n.mjs && env-cmd -f .env.qa vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/jest": "30.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "env-cmd": "11.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "immutable": "5.1.9",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "bun@1.4.1",
  "overrides": {
    "eslint": "10.10.0"
  }
}
